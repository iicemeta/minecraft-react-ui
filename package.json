{
  "name": "@iicemeta/minecraft-react-ui",
  "description": "Minecraft-style React UI components library — modernized fork on React 19 (Vite + Floating UI + dnd-kit + TanStack Virtual)",
  "version": "1.0.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/minecraft-react-ui.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "USAGE.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iicemeta/minecraft-react-ui.git"
  },
  "bugs": {
    "url": "https://github.com/iicemeta/minecraft-react-ui/issues"
  },
  "homepage": "https://github.com/iicemeta/minecraft-react-ui#readme",
  "keywords": [
    "react",
    "react19",
    "components",
    "ui",
    "ui-library",
    "component-library",
    "minecraft",
    "pixel",
    "typescript",
    "vite"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react-dom": "^2.1.9",
    "@tanstack/react-virtual": "^3.13.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "postcss-import": "^16.1.0",
    "postcss-mixins": "^11.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.4.0"
  }
}
